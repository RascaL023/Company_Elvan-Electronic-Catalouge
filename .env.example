# Env boundary: import.meta.env must only be read inside src/config/*,
# src/app/composition.ts, and vite.config.ts. Features, hooks, and
# components consume src/config/* or the composition root instead.

# Store / Brand Configuration (owner: src/config/site.ts)
VITE_STORE_NAME="Elvan Electronic"
VITE_COMPANY_NAME="Kinarya Adika Askari"

# Contact numbers for the storefront header (owner: src/config/site.ts)
VITE_ADMIN_NUMBER=""
VITE_CS1_NUMBER=""
VITE_CS2_NUMBER=""

# Social links for the storefront footer (owner: src/config/site.ts)
VITE_SOCIAL_WA=""
VITE_SOCIAL_IG=""
VITE_SOCIAL_FB=""

# Image Storage Provider: local | imagekit (supported).
# s3 | cloudflare | cloudinary are legacy code paths only (see src/config/storage.ts).
VITE_STORAGE_PROVIDER="imagekit"

# Custom CDN Base URL (used when storage provider is s3, cloudflare, or cloudinary)
# Leave empty to use provider default URLs
VITE_CDN_BASE_URL=""

# Placeholder image path/URL when a product has no images
VITE_PLACEHOLDER_IMAGE_URL="/assets/images/placeholder.png"
VITE_COMPANY_LOGO_IMAGE_URL="/assets/images/company_logo.png"

# Vite Dev Server allowed hosts (comma-separated)
# Example: VITE_ALLOWED_HOSTS="dev.rascal.my.id,localhost:5173"
VITE_ALLOWED_HOSTS=""

# S3 Configuration
VITE_S3_BUCKET=""
VITE_S3_REGION=""

# Cloudflare R2 Configuration
VITE_CLOUDFLARE_ACCOUNT_ID=""
VITE_CLOUDFLARE_BUCKET=""

# Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# ImageKit Configuration
VITE_IMAGEKIT_PUBLIC_KEY=""
VITE_IMAGEKIT_URL_ENDPOINT=""
# Auth endpoint implements GET /signature -> { token, expire, signature }.
# Cloudflare Worker today, or any backend (e.g. VPS) with the same contract.
VITE_IMAGEKIT_AUTH_ENDPOINT=""

# Firebase Configuration
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Future API backend (NOT IMPLEMENTED — see issue #1)
# When the VPS backend exists, set this and the composition root
# (src/app/composition.ts) will wire ApiRepository adapters instead
# of Firebase. Leave empty to keep using Firebase.
# VITE_API_BASE_URL="https://api.example.com"
