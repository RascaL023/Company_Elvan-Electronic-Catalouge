# Store / Brand Configuration
VITE_STORE_NAME="Elvan Electronic"

# Image Storage Provider: local | s3 | cloudflare | cloudinary
VITE_STORAGE_PROVIDER="local"

# Custom CDN Base URL (used when storage provider is s3, cloudflare, or cloudinary)
# Leave empty to use provider default URLs
VITE_CDN_BASE_URL=""

# Placeholder image path/URL when a product has no images
vITE_PLACEHOLDER_IMAGE_URL="/assets/images/placeholder.png"

# Vite Dev Server allowed hosts (comma-separated)
# Example: VITE_ALLOWED_HOSTS="dev.rascal.my.id,localhost:5173"
VITE_ALLOWED_HOSTS=""

# S3 Configuration
VITE_S3_BUCKET=""
VITE_S3_REGION=""

# Cloudflare R2 Configuration
VITE_CLOUDFLARE_ACCOUNT_ID=""
VITE_CLOUDFLARE_BUCKET=""

# Cloudinary Configuration
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""
