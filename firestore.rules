rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // All catalog reads are public
    match /products/{document} {
      allow read: if true;
      allow create, update, delete: if exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /categories/{document} {
      allow read: if true;
      allow write: if exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /brands/{document} {
      allow read: if true;
      allow write: if exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Read-optimized catalog projection (catalog/snapshot).
    // Publicly readable like the other catalog collections, but only
    // admins may write it (kept in sync by product mutations and the
    // rebuild script, which uses the Admin SDK and bypasses rules).
    match /catalog/{document} {
      allow read: if true;
      allow write: if exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
